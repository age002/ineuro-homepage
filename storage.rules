rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // 게시물에 삽입되는 파일은 다운로드 URL을 통해 공개됩니다.
    // 업로드·교체·삭제는 지정된 관리자만 할 수 있습니다.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
